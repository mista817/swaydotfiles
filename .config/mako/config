max-history=5
sort=-time
on-button-left=invoke-default-action
on-button-middle=dismiss-all
on-button-right=dismiss
on-touch=dismiss

font=JetBrainsMono Nerd Font 14
background-color=#16161d
text-color=#dcd7ba
width=300
height=150
padding=12
border-size=2
border-color=#7e9cd8
border-radius=0
progress-color=over #7e9cd8ff
icons=1
max-icon-size=64
default-timeout=10000

[urgency=low]
border-color=#727169
default-timeout=5000

[urgency=critical]
border-color=#c34043
default-timeout=0
